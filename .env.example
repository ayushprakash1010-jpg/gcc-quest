# ── App ─────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_VERSION=0.1.0

# ── Database ────────────────────────────────
DATABASE_URL="postgresql://user:pass@localhost:5432/gccquest"

# ── Redis (Upstash in prod, local in dev) ───
REDIS_URL="redis://localhost:6380"
REDIS_WARN_THRESHOLD=8000          # Log warning if daily commands exceed this

# ── Vector DB ───────────────────────────────
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""                  # Empty for local, set for Qdrant Cloud

# ── LLM ─────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_RPM_LIMIT=14                # Requests per minute (free tier: 15 RPM max)

# ── Auth ─────────────────────────────────────
JWT_SECRET="changeme-secret-1"                      # generate: openssl rand -base64 64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="changeme-secret-2"              # DIFFERENT secret from JWT_SECRET
JWT_REFRESH_EXPIRES_IN=7d
NEXTAUTH_SECRET="changeme-secret-3"                 # generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# ── CORS ─────────────────────────────────────
FRONTEND_URL="http://localhost:3000"   # Vercel URL in prod

# ── BullMQ Board (Basic Auth) ────────────────
BULL_BOARD_USERNAME="admin"
BULL_BOARD_PASSWORD="password"

# ── Monitoring ───────────────────────────────
SENTRY_DSN=""
BETTERSTACK_SOURCE_TOKEN=""

# ── Frontend (Next.js) ───────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
